{
  "title": "Untitled Project",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"theme-color\" content=\"#070b14\">\n<meta name=\"description\" content=\"PIXORA DIGITAL creates premium business websites, e-commerce websites and digital brand identities.\">\n<title>PIXORA DIGITAL | Digital Agency</title>\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n:root{\n--bg:#070b14;\n--card:#101a2b;\n--blue:#168cff;\n--cyan:#57c5ff;\n--white:#f5f8ff;\n--muted:#a6b4c9;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:85px}\nbody{\nfont-family:Inter,sans-serif;background:var(--bg);\ncolor:var(--white);line-height:1.6;overflow-x:hidden\n}\na{text-decoration:none;color:inherit}\nbutton,input,textarea,select{font:inherit}\n.container{width:90%;max-width:1150px;margin:auto}\nheader{\nposition:sticky;top:0;z-index:100;\nbackground:#070b14ed;backdrop-filter:blur(15px);\nborder-bottom:1px solid #ffffff15\n}\nnav{height:75px;display:flex;align-items:center;justify-content:space-between}\n.logo{font-size:23px;font-weight:800;letter-spacing:1px}\n.logo span{color:var(--blue)}\n.navlinks{display:flex;gap:23px;align-items:center}\n.navlinks a{font-size:13px;color:#dce7f8}\n.navlinks a:hover{color:var(--cyan)}\n.btn{\ndisplay:inline-block;background:linear-gradient(100deg,#0877ed,#21b2ff);\npadding:13px 23px;border:0;border-radius:8px;\ncolor:white;font-weight:700;cursor:pointer;\ntransition:.25s\n}\n.btn:hover{transform:translateY(-3px);box-shadow:0 8px 30px #168cff55}\n.hero{\nmin-height:650px;display:grid;place-items:center;text-align:center;\nbackground:radial-gradient(ellipse at 50% 35%,#12539a55,transparent 65%);\npadding:90px 0\n}\n.tag{\ndisplay:inline-block;border:1px solid #168cff66;color:#64bdff;\npadding:7px 16px;border-radius:30px;font-size:12px;margin-bottom:23px\n}\nh1{font-size:clamp(39px,7vw,78px);line-height:1.13;letter-spacing:-3px}\nh1 span{color:var(--blue)}\n.hero p{max-width:650px;color:var(--muted);margin:22px auto 30px}\n.hero-actions{display:flex;justify-content:center;gap:13px;flex-wrap:wrap}\n.btn-outline{border:1px solid #168cff;padding:12px 22px;border-radius:8px;color:#69bfff}\nsection{padding:85px 0}\n.section-title{text-align:center;margin-bottom:43px}\n.section-title h2{font-size:clamp(27px,4vw,39px)}\n.section-title p{color:var(--muted);margin-top:9px}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.card{\npadding:27px;background:var(--card);border:1px solid #ffffff12;\nborder-radius:14px;transition:.3s\n}\n.card:hover{transform:translateY(-5px);border-color:var(--blue)}\n.symbol{font-size:32px;margin-bottom:15px}\n.card h3{margin-bottom:8px}\n.card p{font-size:14px;color:var(--muted)}\n.about{\nbackground:#0b1423;border-block:1px solid #ffffff12\n}\n.about-inner{text-align:center;max-width:760px;margin:auto}\n.about-inner p{color:var(--muted);margin:17px 0 25px}\n.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:35px}\n.stat{background:#111e32;padding:20px;border-radius:12px}\n.stat h3{font-size:25px;color:var(--cyan)}\n.stat p{font-size:12px;color:var(--muted)}\n.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.project{\npadding:35px;border:1px solid #ffffff18;border-radius:14px;\nbackground:linear-gradient(140deg,#142e51,#101827)\n}\n.project small{color:var(--cyan);letter-spacing:1px}\n.project h3{margin:12px 0}\n.project p{font-size:14px;color:var(--muted)}\n.project a{display:inline-block;margin-top:18px;color:var(--cyan)}\n.process{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}\n.process div{padding:20px;border:1px solid #ffffff18;border-radius:12px}\n.process b{color:var(--cyan);font-size:23px}\n.process p{font-size:13px;color:var(--muted);margin-top:8px}\n.contact{\nbackground:radial-gradient(ellipse at center,#12345a55,transparent 75%)\n}\n.contact-wrap{\nmax-width:700px;margin:auto;padding:30px;\nbackground:var(--card);border:1px solid #ffffff18;border-radius:16px\n}\nform{display:grid;gap:14px;margin-top:22px}\ninput,textarea,select{\nwidth:100%;padding:14px;background:#080f1c;color:white;\nborder:1px solid #2a3c55;border-radius:8px;outline:none\n}\ninput:focus,textarea:focus,select:focus{border-color:var(--blue)}\ntextarea{min-height:110px;resize:vertical}\nfooter{\nborder-top:1px solid #ffffff15;padding:35px 0;\ntext-align:center;color:var(--muted);font-size:13px\n}\n.social{color:var(--cyan);font-weight:700}\n\n/* CHAT ASSISTANT */\n.chat-launch{\nposition:fixed;right:22px;bottom:22px;z-index:200;\nborder:0;border-radius:50px;padding:15px 20px;\nbackground:linear-gradient(110deg,#0877ed,#21b2ff);\ncolor:white;font-weight:700;cursor:pointer;\nbox-shadow:0 5px 30px #168cff66\n}\n.chat-box{\ndisplay:none;position:fixed;right:20px;bottom:85px;\nwidth:min(360px,calc(100% - 30px));height:480px;\nmax-height:70vh;background:#101a2b;\nborder:1px solid #168cff77;border-radius:17px;\nz-index:200;overflow:hidden;box-shadow:0 15px 50px #0009\n}\n.chat-head{\npadding:17px;background:linear-gradient(100deg,#0865cf,#168cff);\ndisplay:flex;justify-content:space-between;align-items:center\n}\n.chat-head small{display:block;font-size:11px;color:#e2f2ff}\n.chat-head button{background:none;border:0;color:white;font-size:23px;cursor:pointer}\n.chat-messages{\nheight:310px;overflow-y:auto;padding:14px;\ndisplay:flex;flex-direction:column;gap:11px\n}\n.msg{\nmax-width:88%;padding:11px 13px;border-radius:12px;\nfont-size:13px;white-space:pre-wrap\n}\n.bot{background:#1c2d46;align-self:flex-start}\n.user{background:#086fd6;align-self:flex-end}\n.quick{display:flex;flex-wrap:wrap;gap:6px;padding:0 12px 10px}\n.quick button{\nbackground:#172a43;border:1px solid #168cff66;\ncolor:#cdeaff;padding:7px 9px;border-radius:20px;\nfont-size:11px;cursor:pointer\n}\n.chat-input{display:flex;gap:7px;padding:10px;border-top:1px solid #ffffff18}\n.chat-input input{min-width:0;padding:11px}\n.chat-input button{background:var(--blue);color:white;border:0;padding:0 14px;border-radius:8px;cursor:pointer}\n@media(max-width:750px){\n.navlinks{gap:10px}\n.navlinks a:not(.btn){display:none}\n.grid{grid-template-columns:1fr}\n.projects{grid-template-columns:1fr}\n.process{grid-template-columns:repeat(2,1fr)}\n.stats{grid-template-columns:1fr}\n.hero{min-height:560px}\nh1{letter-spacing:-1.5px}\nsection{padding:65px 0}\n.contact-wrap{padding:20px}\n}\n@media(prefers-reduced-motion:reduce){\nhtml{scroll-behavior:auto}\n*,*::before,*::after{transition:none!important}\n}\n</style>\n</head>\n\n<body>\n<header>\n<div class=\"container\">\n<nav>\n<a href=\"#home\" class=\"logo\">PIXORA<span>.</span></a>\n<div class=\"navlinks\">\n<a href=\"#home\">Home</a>\n<a href=\"#services\">Services</a>\n<a href=\"#work\">Portfolio</a>\n<a href=\"#about\">About</a>\n<a href=\"#contact\" class=\"btn\">Let's Talk</a>\n</div>\n</nav>\n</div>\n</header>\n\n<main>\n<section class=\"hero\" id=\"home\">\n<div class=\"container\">\n<div class=\"tag\">✦ YOUR DIGITAL GROWTH PARTNER</div>\n<h1>We Build Your<br><span>Digital Identity.</span></h1>\n<p>We transform your business ideas into powerful digital experiences with modern websites, creative design and smart solutions.</p>\n<div class=\"hero-actions\">\n<a href=\"#contact\" class=\"btn\">Start Your Project →</a>\n<a href=\"#services\" class=\"btn-outline\">Explore Services</a>\n</div>\n</div>\n</section>\n\n<section id=\"services\">\n<div class=\"container\">\n<div class=\"section-title\">\n<h2>What We Do</h2>\n<p>Creative solutions for ambitious businesses.</p>\n</div>\n<div class=\"grid\">\n<div class=\"card\"><div class=\"symbol\">💻</div><h3>Website Design</h3><p>Modern and professional websites for your brand.</p></div>\n<div class=\"card\"><div class=\"symbol\">📱</div><h3>Mobile Responsive</h3><p>Beautiful experiences on mobile, tablet and desktop.</p></div>\n<div class=\"card\"><div class=\"symbol\">🛍️</div><h3>E-Commerce</h3><p>Online storefront concepts for products and services.</p></div>\n<div class=\"card\"><div class=\"symbol\">🎨</div><h3>Logo & Branding</h3><p>Creative visual identity for your business.</p></div>\n<div class=\"card\"><div class=\"symbol\">⚡</div><h3>Website Redesign</h3><p>Give your old website a fresh, modern look.</p></div>\n<div class=\"card\"><div class=\"symbol\">🌐</div><h3>Domain Setup</h3><p>Custom domain connection and website publishing support.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"about\" id=\"about\">\n<div class=\"container\">\n<div class=\"about-inner\">\n<div class=\"tag\">ABOUT PIXORA</div>\n<h2>Ideas Into Digital Reality.</h2>\n<p>PIXORA DIGITAL is a creative digital brand focused on modern website design, development and branding. We aim to help businesses build a strong and professional online presence.</p>\n<a href=\"#contact\" class=\"btn\">Let's Work Together</a>\n<div class=\"stats\">\n<div class=\"stat\"><h3>01</h3><p>Creative Approach</p></div>\n<div class=\"stat\"><h3>24/7</h3><p>Online Enquiry</p></div>\n<div class=\"stat\"><h3>100%</h3><p>Project Focus</p></div>\n</div>\n</div>\n</div>\n</section>\n\n<section id=\"work\">\n<div class=\"container\">\n<div class=\"section-title\">\n<h2>Selected Projects</h2>\n<p>Explore our website concepts and creative work.</p>\n</div>\n<div class=\"projects\">\n<div class=\"project\">\n<small>RESTAURANT WEBSITE CONCEPT</small>\n<h3>Shree Cafe & Restaurant</h3>\n<p>Restaurant website concept featuring menu, gallery, booking enquiry and contact information.</p>\n<a href=\"https://dirakuvishwakarma888-crypto.github.io/shree-cafe/#home\" target=\"_blank\" rel=\"noopener\">View Website ↗</a>\n</div>\n<div class=\"project\">\n<small>YOUR NEXT PROJECT</small>\n<h3>Your Business Here</h3>\n<p>Let's build a professional digital identity for your business.</p>\n<a href=\"#contact\">Start a Project →</a>\n</div>\n</div>\n</div>\n</section>\n\n<section>\n<div class=\"container\">\n<div class=\"section-title\">\n<h2>How We Work</h2>\n<p>A simple process from idea to launch.</p>\n</div>\n<div class=\"process\">\n<div><b>01</b><h3>Discuss</h3><p>Understand your business needs.</p></div>\n<div><b>02</b><h3>Design</h3><p>Create your website concept.</p></div>\n<div><b>03</b><h3>Develop</h3><p>Build and test your website.</p></div>\n<div><b>04</b><h3>Launch</h3><p>Publish your approved website.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"contact\" id=\"contact\">\n<div class=\"container\">\n<div class=\"section-title\">\n<h2>Let's Build Something Great.</h2>\n<p>Tell us about your project. We would love to hear your idea.</p>\n</div>\n<div class=\"contact-wrap\">\n<h3>Project Enquiry 🚀</h3>\n<form id=\"contactForm\">\n<input id=\"name\" placeholder=\"Your Full Name\" required>\n<input id=\"business\" placeholder=\"Business / Company Name\" required>\n<input id=\"phone\" type=\"tel\" placeholder=\"Your Contact Number\" required>\n<select id=\"service\" required>\n<option value=\"\">Choose a Service</option>\n<option>Business Website</option>\n<option>Restaurant Website</option>\n<option>E-Commerce Website</option>\n<option>Logo & Branding</option>\n<option>Website Redesign</option>\n<option>Other</option>\n</select>\n<textarea id=\"message\" placeholder=\"Describe your project...\" required></textarea>\n<button class=\"btn\" type=\"submit\">Send Enquiry on WhatsApp →</button>\n</form>\n</div>\n</div>\n</section>\n</main>\n\n<footer>\n<div class=\"container\">\n<h2>PIXORA<span style=\"color:#168cff\"> DIGITAL</span></h2>\n<p>We Build Your Digital Identity.</p>\n<p>Instagram: <a class=\"social\" href=\"https://instagram.com/thepixora._studio\" target=\"_blank\" rel=\"noopener\">@thepixora._studio</a></p>\n<p>WhatsApp: +91 7004255283</p>\n<p style=\"margin-top:15px\">© 2026 PIXORA DIGITAL. All Rights Reserved.</p>\n</div>\n</footer>\n\n<!-- TALK TO PIXORA ASSISTANT -->\n<button class=\"chat-launch\" id=\"chatLaunch\">✦ Talk to PIXORA</button>\n\n<div class=\"chat-box\" id=\"chatBox\">\n<div class=\"chat-head\">\n<div><b>✦ PIXORA Assistant</b><small>Online • Guided Support</small></div>\n<button id=\"chatClose\" aria-label=\"Close chat\">×</button>\n</div>\n<div class=\"chat-messages\" id=\"chatMessages\" aria-live=\"polite\">\n<div class=\"msg bot\">Hello! 👋 Welcome to PIXORA DIGITAL.\n\nI'm your website assistant. How can I help you today?</div>\n</div>\n<div class=\"quick\" id=\"quick\">\n<button data-msg=\"What services do you offer?\">Our Services</button>\n<button data-msg=\"How can I get a website?\">Get a Website</button>\n<button data-msg=\"How can I contact you?\">Contact</button>\n</div>\n<div class=\"chat-input\">\n<input id=\"chatInput\" placeholder=\"Type your message...\" aria-label=\"Chat message\">\n<button id=\"chatSend\">Send</button>\n</div>\n</div>\n\n<script>\nconst WA = \"917004255283\";\n\nfunction openWhatsApp(text){\nwindow.open(\"https://wa.me/\"+WA+\"?text=\"+encodeURIComponent(text),\"_blank\");\n}\n\n// PROJECT ENQUIRY\ndocument.getElementById(\"contactForm\").addEventListener(\"submit\",function(e){\ne.preventDefault();\nconst data = {\nname:document.getElementById(\"name\").value.trim(),\nbusiness:document.getElementById(\"business\").value.trim(),\nphone:document.getElementById(\"phone\").value.trim(),\nservice:document.getElementById(\"service\").value,\nmessage:document.getElementById(\"message\").value.trim()\n};\nif(!data.name || !data.business || !data.phone || !data.service || !data.message)return;\nconst text = `Hello PIXORA DIGITAL! I want to enquire about a project.\n\nName: ${data.name}\nBusiness: ${data.business}\nContact: ${data.phone}\nService: ${data.service}\nDetails: ${data.message}`;\nopenWhatsApp(text);\n});\n\n// CHAT WIDGET\nconst box=document.getElementById(\"chatBox\");\nconst messages=document.getElementById(\"chatMessages\");\nconst input=document.getElementById(\"chatInput\");\n\ndocument.getElementById(\"chatLaunch\").onclick=()=>{\nbox.style.display=\"block\";\ninput.focus();\n};\ndocument.getElementById(\"chatClose\").onclick=()=>box.style.display=\"none\";\n\nfunction addMessage(text,type){\nconst div=document.createElement(\"div\");\ndiv.className=\"msg \"+type;\ndiv.textContent=text;\nmessages.appendChild(div);\nmessages.scrollTop=messages.scrollHeight;\n}\n\nfunction getReply(text){\nconst t=text.toLowerCase();\n\nif(/hello|hi|hey|namaste/.test(t))\nreturn \"Hello! Welcome to PIXORA DIGITAL. 😊 What kind of digital solution are you looking for?\";\n\nif(/service|offer|work|website|design/.test(t))\nreturn \"We offer:\\n💻 Business Website Design\\n📱 Mobile Responsive Websites\\n🛍️ E-Commerce Websites\\n🎨 Logo & Branding\\n⚡ Website Redesign\\n🌐 Domain Setup\\n\\nWhich service interests you?\";\n\nif(/price|cost|charge|rate|budget/.test(t))\nreturn \"Website pricing depends on features, pages and requirements. Tell us about your project and our team can discuss a suitable quotation.\";\n\nif(/contact|whatsapp|number|phone/.test(t))\nreturn \"You can contact PIXORA DIGITAL on WhatsApp: +91 7004255283\\nInstagram: @thepixora._studio\";\n\nif(/time|days|delivery|complete/.test(t))\nreturn \"Project timelines depend on the website size and features. Contact us with your requirements for an estimated timeline.\";\n\nif(/portfolio|project|example|shree/.test(t))\nreturn \"You can explore our Shree Cafe website concept here:\\nhttps://dirakuvishwakarma888-crypto.github.io/shree-cafe/\";\n\nif(/domain|hosting/.test(t))\nreturn \"We can help you with custom domain setup and website publishing. Share your preferred domain name with us.\";\n\nif(/thank/.test(t))\nreturn \"You're welcome! Thank you for considering PIXORA DIGITAL. 🚀\";\n\nreturn \"Thanks for your message! For a detailed discussion, send your requirements to our WhatsApp. Our contact number is +91 7004255283.\";\n}\n\nfunction sendChat(){\nconst text=input.value.trim();\nif(!text)return;\naddMessage(text,\"user\");\ninput.value=\"\";\nsetTimeout(()=>addMessage(getReply(text),\"bot\"),350);\n}\n\ndocument.getElementById(\"chatSend\").onclick=sendChat;\ninput.addEventListener(\"keydown\",e=>{\nif(e.key===\"Enter\")sendChat();\n});\n\ndocument.getElementById(\"quick\").addEventListener(\"click\",e=>{\nconst msg=e.target.dataset.msg;\nif(msg){\ninput.value=msg;\nsendChat();\n}\n});\n</script>\n</body>\n</html>"
  },
